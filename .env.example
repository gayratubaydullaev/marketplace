# Database — never commit real credentials
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@localhost:5432/marketplace?sslmode=require

REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

KAFKA_BROKERS=localhost:9092

ELASTICSEARCH_URL=http://localhost:9200

CLICKHOUSE_URL=http://localhost:8123

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=marketplace
MINIO_SECURE=true

# JWT: set PEM for RS256 production; JWT_SECRET used only as HS256 fallback in development
JWT_SECRET=CHANGE_ME_USE_RS256_IN_PROD
# JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_KID=gayrat-rs256-1
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
APP_ENV=development

# Production checklist:
# - APP_ENV=production (disables default JWT, admin seed, OTP/dev tokens, payment sandbox unless explicitly enabled)
# - Set JWT_PRIVATE_KEY_PEM + JWT_PUBLIC_KEY_PEM (or a strong non-default JWT_SECRET)
# - PAYMENTS_SANDBOX=false (or omit — sandbox is opt-in only when APP_ENV=production)
# - CORS_ORIGINS=https://gayrat.uz,https://www.gayrat.uz,https://admin.gayrat.uz,https://vendor.gayrat.uz,https://courier.gayrat.uz
# - Create admin via secure ops process (bootstrap seed is disabled in production)

DEFAULT_LOCALE=uz
DEFAULT_CURRENCY=UZS

# Frontend — single gateway (Kong or scripts/dev-gateway.sh)
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Payments (sandbox shaped — no live money). In production set PAYMENTS_SANDBOX=false.
PAYMENTS_SANDBOX=true
PAYMENTS_PUBLIC_BASE=http://localhost:8006
PAYME_MERCHANT_ID=gayrat-payme
CLICK_MERCHANT_ID=gayrat-click
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
UZUM_MERCHANT_ID=gayrat-uzum
UZUM_API_BASE=
PAYME_TEST=false
STRIPE_SECRET=sk_test_dev
PAYME_SECRET=CHANGE_ME
CLICK_SECRET=CHANGE_ME
UZUM_SECRET=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Live webhook endpoints (configure in PSP cabinets):
#   POST {GATEWAY}/v1/payments/webhooks/payme
#   POST {GATEWAY}/v1/payments/webhooks/click
#   POST {GATEWAY}/v1/payments/webhooks/uzum
#   POST {GATEWAY}/v1/payments/webhooks/stripe
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME

# OAuth and messaging integrations
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
APPLE_OAUTH_CLIENT_ID=CHANGE_ME

FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME

TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM=CHANGE_ME

ESKIZ_EMAIL=CHANGE_ME
ESKIZ_PASSWORD=CHANGE_ME
ESKIZ_FROM=CHANGE_ME

# Operations — include all local panel origins when developing
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
SENTRY_DSN=
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
FCM_SERVER_KEY=CHANGE_ME

# Shipping: local (default) | easypost | shipstation
SHIPPING_PROVIDER=local
# EASYPOST_API_KEY=
# SHIPSTATION_API_KEY=
# SHIPSTATION_API_SECRET=

# Optional remote review toxicity check (POST {"text"} → {"toxic":bool})
# TOXICITY_API_URL=
# TOXICITY_API_KEY=

# Frontend (optional)
# NEXT_PUBLIC_API_BASE=http://localhost:8080
# NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Embedded maps: set Yandex Maps JS API key to prefer Yandex Maps; otherwise Leaflet+OSM.
# https://developer.tech.yandex.ru/ — create a key with "JavaScript API and HTTP Geocoder" (Maps).
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Geocoding (server-side only) — Yandex is recommended for Uzbekistan streets
# https://developer.tech.yandex.ru/
# YANDEX_GEOCODER_API_KEY=
